# Superpowers working documents — local only, never published
docs/superpowers/

# Graphify knowledge-graph output. Regenerated from the source tree on demand,
# and it vendors a bundled graph.html plus a SHA256 cache that no reviewer
# should be asked to read in a diff.
graphify-out/

# Graphify's --project install writes .claude/settings.json with an absolute,
# machine-specific hook path (C:/Users/<name>/.local/bin/graphify.EXE). Sharing
# that would fire a broken hook on every tool call in any other clone or in CI.
# Local tooling, not shared config.
.claude/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Quarto build output
/tome/_book/
/tome/_site/
/tome/.quarto/
# Execution cache for the executable cells in index.qmd. Regenerated by
# `quarto render`, and it vendors minified JS that no reviewer should be asked
# to read in a diff.
/_freeze/

# No data in the repository. The notebooks carry their outputs, so a reader sees
# every number without holding the data; running the book locally needs a copy
# of `data/sample`, which is published separately if at all.
/data/

# DVC-managed data (pointers and dvc.lock are tracked; contents are not)
/vault/

# Streamlit
.streamlit/secrets.toml

# seleniumbase / chromedriver artifacts from soccerdata scraping
downloaded_files/
latest_logs/

# Environment
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
# Shared so a fresh clone picks the project venv instead of a global
# interpreter, which is the difference between notebooks running and not.
!.vscode/settings.json

/.quarto/
**/*.quarto_ipynb
